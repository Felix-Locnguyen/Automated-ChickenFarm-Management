# 05_docker/.env.example — biến bí mật cho docker-compose
# Cách dùng:  cp 05_docker/.env.example 05_docker/.env  rồi sửa giá trị thật
# File .env đã nằm trong .gitignore — KHÔNG commit.

# Ký JWT — BẮT BUỘC đổi khi deploy thật (tạo bằng: openssl rand -hex 32)
SECRET_KEY=dev-secret-doi-truoc-khi-deploy

# PostgreSQL (user farm trong compose)
POSTGRES_PASSWORD=farmpg123

# MinIO (console http://localhost:9001)
MINIO_ROOT_USER=farmminio
MINIO_ROOT_PASSWORD=farmminio123
